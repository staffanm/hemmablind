    {"id": "rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 11, "filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["match", ["get", "class"], ["rail", "transit"], true, false], ["!=", ["get", "brunnel"], "tunnel"]], "paint": {"line-color": "#8f8672", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 11, 0.8, 16, 2.5]}},
