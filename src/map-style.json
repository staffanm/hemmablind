    {"id": "road-service-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 13, "filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["match", ["get", "class"], ["service", "track"], true, false]], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#d6c69e", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 13, 2.5, 15, 3.5, 17, 7, 19, 14], "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.3, 1]}},
