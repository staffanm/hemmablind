    {"id": "water-edge", "type": "line", "source": "openmaptiles", "source-layer": "water", "filter": ["all", ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false], ["!=", ["get", "brunnel"], "tunnel"]], "minzoom": 11, "paint": {"line-color": "#4fa9c0", "line-width": 1.2}},
