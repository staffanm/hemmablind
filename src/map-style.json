    {"id": "aeroway-runway", "type": "line", "source": "openmaptiles", "source-layer": "aeroway", "filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["match", ["get", "class"], ["runway", "taxiway"], true, false]], "minzoom": 11, "paint": {"line-color": "#d3c9b0", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 11, 2, 16, 30]}},
