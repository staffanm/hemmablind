    {"id": "landcover-wetland", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["all", ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false], ["match", ["get", "class"], ["wetland"], true, false]], "paint": {"fill-color": "#bfdcc0", "fill-opacity": 1, "fill-antialias": false}},
    {"id": "landcover-sand", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["all", ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false], ["match", ["get", "class"], ["sand"], true, false]], "paint": {"fill-color": "#f6e3a1", "fill-opacity": 1, "fill-antialias": false}},
