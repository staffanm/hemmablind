    {"id": "landuse-green", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "filter": ["all", ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false], ["match", ["get", "class"], ["cemetery", "pitch", "playground", "stadium", "track", "theme_park", "zoo"], true, false]], "paint": {"fill-color": "#c2dc94"}},
