    {"id": "road-motorway-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 5, "filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["match", ["get", "class"], ["motorway"], true, false]], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#c97b4a", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 6, 2.8, 12, 4.5, 14, 7.5, 16, 14, 18, 30], "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.3, 1]}},
    {"id": "road-service", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 13, "filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["match", ["get", "class"], ["service", "track"], true, false]], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#fbf5e4", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 13, 0.5, 15, 1.5, 17, 5, 19, 12], "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.3, 1]}},
    {"id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 11, "filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["match", ["get", "class"], ["minor"], true, false]], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#fffaf0", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 12, 0.6, 14, 2.5, 16, 7, 18, 18], "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.3, 1]}},
