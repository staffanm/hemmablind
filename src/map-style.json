    {"id": "building", "type": "fill-extrusion", "source": "openmaptiles", "source-layer": "building", "minzoom": 14, "paint": {"fill-extrusion-color": ["interpolate", ["linear"], ["get", "render_height"], 0, "#e6d3aa", 30, "#d7b987", 100, "#c69e6c"], "fill-extrusion-height": ["interpolate", ["linear"], ["zoom"], 14, 0, 14.6, ["get", "render_height"]], "fill-extrusion-base": ["interpolate", ["linear"], ["zoom"], 14, 0, 14.6, ["get", "render_min_height"]], "fill-extrusion-opacity": 0.92}},
    {"id": "label-waterway", "type": "symbol", "source": "openmaptiles", "source-layer": "waterway", "filter": ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], "layout": {"text-field": ["get", "name"], "text-font": ["Noto Sans Italic"], "text-size": 12, "symbol-placement": "line", "symbol-spacing": 350}, "paint": {"text-color": "#2d7f95", "text-halo-color": "#f4ecd6", "text-halo-width": 1.6}, "minzoom": 13},
    {"id": "label-water", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name", "filter": ["match", ["geometry-type"], ["Point", "MultiPoint"], true, false], "layout": {"text-field": ["get", "name"], "text-font": ["Noto Sans Italic"], "text-size": ["interpolate", ["exponential", 1], ["zoom"], 8, 11, 16, 15], "text-max-width": 6}, "paint": {"text-color": "#2d7f95", "text-halo-color": "#f4ecd6", "text-halo-width": 1.6}},
