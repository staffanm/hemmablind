    {"id": "landuse-work", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "filter": ["all", ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false], ["match", ["get", "class"], ["industrial", "commercial", "retail", "railway", "garages"], true, false]], "paint": {"fill-color": "#e2d6b9"}},
    {"id": "landcover-farmland", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["all", ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false], ["match", ["get", "class"], ["farmland"], true, false]], "paint": {"fill-color": "#eae3b4", "fill-opacity": 1, "fill-antialias": false}},
    {"id": "landcover-grass", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["all", ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false], ["match", ["get", "class"], ["grass"], true, false]], "paint": {"fill-color": "#cfe3a2", "fill-opacity": 1, "fill-antialias": false}},
